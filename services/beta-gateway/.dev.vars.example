# Copy to .dev.vars locally; never commit the copy. No secrets belong in the app.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_BYOK_PRICE_ID=price_REPLACE
STRIPE_MANAGED_PRICE_ID=price_REPLACE
# Your deployed gateway origin; used for fixed Checkout/Portal return URLs.
PUBLIC_ORIGIN=https://sclip-beta-gateway.YOUR_SUBDOMAIN.workers.dev
OPENROUTER_API_KEY=SERVER_ONLY_FUNDED_INFERENCE_KEY
PEXELS_API_KEY=SERVER_ONLY_OPTIONAL
PIXABAY_API_KEY=SERVER_ONLY_OPTIONAL
