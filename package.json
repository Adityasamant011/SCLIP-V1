{
  "name": "sclip",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "SCLIP: Agentic AI Desktop Video Editor with MCP tool surface and embedded creative intelligence",
  "author": "Aditya Samant <adityasamant011@gmail.com> (https://github.com/Adityasamant011)",
  "homepage": "https://github.com/Adityasamant011/SCLIP-V1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adityasamant011/SCLIP-V1.git"
  },
  "bugs": {
    "url": "https://github.com/Adityasamant011/SCLIP-V1/issues"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "version:release": "node apps/desktop/scripts/release.mjs version",
    "bootstrap": "npm --workspace apps/desktop run bootstrap",
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "test": "npm --workspace apps/desktop run test --",
    "test:scripts": "npm --workspace apps/desktop run test:scripts",
    "e2e": "npm --workspace apps/desktop run e2e --",
    "build:e2e": "npm --workspace apps/desktop run build:e2e",
    "package": "npm --workspace apps/desktop run package",
    "knip": "npx --yes knip"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  }
}
